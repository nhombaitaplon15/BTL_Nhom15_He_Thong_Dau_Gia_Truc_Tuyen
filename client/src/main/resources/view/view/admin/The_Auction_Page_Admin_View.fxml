<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane style="-fx-background-color: #F4F7FE;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.admin.The_Auction_Page_Admin_View_Controller">
    <children>
        <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <HBox alignment="CENTER_LEFT" minHeight="60.0" prefHeight="60.0" spacing="20.0" style="-fx-background-color: white;">
                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                    <children>
                        <Button mnemonicParsing="false" onAction="#goToHomePage" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #A3AED0;" text="Trang chủ">
                            <font>
                                <Font name="Times New Roman Bold" size="16.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #2B3674; -fx-border-color: #3989b9; -fx-border-width: 0 0 3 0;" text="Danh sách đấu giá">
                            <font>
                                <Font name="Times New Roman Bold" size="16.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#goToTransactionPage" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #A3AED0;" text="Quản lý giao dịch">
                            <font>
                                <Font name="Times New Roman Bold" size="16.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <VBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                    <children>

                        <Label text="Danh sách phiên đấu giá" textFill="#2B3674">
                            <font>
                                <Font name="Times New Roman Bold" size="24.0" />
                            </font>
                        </Label>

                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <TextField prefHeight="42.0" prefWidth="300.0" promptText="🔍 Tìm kiếm ID, Tên sản phẩm..." style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #E9EDF7; -fx-border-radius: 10;">
                                    <font>
                                        <Font name="Times New Roman" size="14.0" />
                                    </font>
                                </TextField>

                                <Region HBox.hgrow="ALWAYS" />

                                <ComboBox prefHeight="42.0" prefWidth="160.0" promptText="Trạng thái" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #E9EDF7; -fx-border-radius: 10; -fx-cursor: hand;" />
                                <ComboBox prefHeight="42.0" prefWidth="160.0" promptText="Thời gian" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #E9EDF7; -fx-border-radius: 10; -fx-cursor: hand;" />


                            </children>
                        </HBox>

                        <VBox>
                            <children>
                                <TableView fx:id="auctionTable" prefHeight="650.0" prefWidth="1150.0" style="-fx-background-color: #FFFFFF;" styleClass="my-table" stylesheets="@../css/style.css" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colItemAndId" prefWidth="320.0" text="Sản phẩm &amp; Mã phiên" />
                                        <TableColumn fx:id="colParticipants" prefWidth="220.0" text="Đối tượng tham gia" />
                                        <TableColumn fx:id="colFinancials" prefWidth="180.0" text="Tài chính &amp; Thị trường" />
                                        <TableColumn fx:id="colStatusAndTime" prefWidth="210.0" text="Trạng thái &amp; Thời gian" />
                                        <TableColumn fx:id="colAction" prefWidth="220.0" text="Trung tâm xử lý" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>



                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
