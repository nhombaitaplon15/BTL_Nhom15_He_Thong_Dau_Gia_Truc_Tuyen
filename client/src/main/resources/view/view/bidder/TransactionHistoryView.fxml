<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import java.net.URL?>
<AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.bidder.TransactionHistoryController">
    <stylesheets>
        <URL value="@../css/transaction-history.css" />
    </stylesheets>
    <children>
        <VBox alignment="TOP_CENTER" spacing="25.0" style="-fx-padding: 30 60 30 60;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <HBox alignment="CENTER_LEFT" prefWidth="1160.0" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleBackToHome" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #2563EB;                                        -fx-border-color: #2563EB; -fx-border-radius: 8; -fx-cursor: hand;" text="← Quay lại">
                            <font><Font name="Times New Roman Bold" size="18.0" /></font>
                            <padding><Insets left="20.0" right="20.0" /></padding>
                        </Button>
                        <VBox spacing="4.0">
                            <children>
                                <Label text="⏱ LỊCH SỬ GIAO DỊCH" textFill="#2563EB">
                                    <font><Font name="Times New Roman Bold" size="28.0" /></font>
                                </Label>
                                <Label text="Danh sách các giao dịch nạp tiền và rút tiền của bạn" textFill="#64748B">
                                    <font><Font name="Times New Roman" size="16.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Separator prefWidth="1160.0" style="-fx-opacity: 0.5;" />

                <VBox maxWidth="1160.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 16;                              -fx-effect: dropshadow(three-pass-box, rgba(37,99,235,0.08), 20, 0, 0, 10);" VBox.vgrow="ALWAYS">
                    <children>

                        <TableView fx:id="tableHistory" prefHeight="530.0" prefWidth="1160.0" styleClass="transaction-table">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="140.0" >
                                    <graphic>
                                        <Label styleClass="col-header" text="Mã Giao Dịch" />
                                    </graphic>
                                </TableColumn>
                                <TableColumn fx:id="colType" prefWidth="180.0">
                                    <graphic>
                                        <Label styleClass="col-header" text="Loại Giao Dịch" />
                                    </graphic>
                                </TableColumn>
                                <TableColumn fx:id="colAmount" prefWidth="240.0">
                                    <graphic>
                                        <Label styleClass="col-header" text="Số Tiền" />
                                    </graphic>
                                </TableColumn>
                                <TableColumn fx:id="colTime" prefWidth="260.0">
                                    <graphic>
                                        <Label styleClass="col-header" text="Thời Gian" />
                                    </graphic>
                                </TableColumn>
                                <TableColumn fx:id="colStatus" prefWidth="200.0">
                                    <graphic>
                                        <Label styleClass="col-header" text="Trạng Thái" />
                                    </graphic>
                                </TableColumn>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                    </children>
                </VBox>

            </children>
        </VBox>
    </children>
</AnchorPane>