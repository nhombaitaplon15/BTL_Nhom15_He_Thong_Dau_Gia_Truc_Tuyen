<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?><?import javafx.scene.layout.HBox?><?import javafx.scene.control.Label?><?import javafx.scene.text.Font?><?import javafx.scene.shape.Line?><?import javafx.scene.layout.AnchorPane?>


<HBox prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.bidder.MainContainerController">
    <children>
        <VBox fx:id="sideMenu" prefHeight="720.0" prefWidth="280.0" spacing="10.0" style="-fx-background-color: #2563EB; -fx-padding: 25 15 25 15;" HBox.hgrow="NEVER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 0 0 10 0;">
                    <children>
                        <Label style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-padding: 6 12 6 12;" text="⚡" textFill="#2563EB">
                            <font><Font name="Times New Roman Bold" size="20.0" /></font>
                        </Label>
                        <Label text="HỆ THỐNG" textFill="WHITE">
                            <font><Font name="Times New Roman Bold" size="22.0" /></font>
                        </Label>
                    </children>
                </HBox>

                <Line endX="220.0" opacity="0.35" stroke="#FFFFFF" strokeWidth="1.5" />

                <VBox spacing="5.0" style="-fx-background-color: rgba(255, 255, 255, 0.15); -fx-background-radius: 12; -fx-padding: 15;">
                    <children>
                        <Label text="Tài khoản" textFill="#E0F2FE">
                            <font><Font name="Times New Roman" size="14.0" /></font>
                        </Label>
                        <Label fx:id="lblAccountName" text="" textFill="WHITE">
                            <font><Font name="Times New Roman Bold" size="18.0" /></font>
                        </Label>
                        <HBox alignment="BOTTOM_LEFT" spacing="5.0" style="-fx-padding: 6 0 0 0;">
                            <children>
                                <Label text="Số dư:" textFill="#E0F2FE">
                                    <font><Font name="Times New Roman" size="14.0" /></font>
                                </Label>
                                <Label fx:id="lblBalance" text="" textFill="#FDE047">
                                    <font><Font name="Times New Roman Bold" size="20.0" /></font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                    <VBox.margin><Insets bottom="15.0" top="10.0" /></VBox.margin>
                </VBox>

                <Button fx:id="btnMenuLive" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#onLiveMenuClick" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: #FFFFFF; -fx-text-fill: #2563EB; -fx-background-radius: 8; -fx-cursor: hand;" text=" 🏛 Sàn Đấu Giá ">
                    <font><Font name="Times New Roman Bold" size="15.0" /></font>
                </Button>
                <Button fx:id="btnMenuHistory" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#onHistoryMenuClick" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #FFFFFF; -fx-background-radius: 8; -fx-cursor: hand;" text=" ⏱ Lịch Sử Đặt Giá">
                    <font><Font name="Times New Roman Bold" size="15.0" /></font>
                </Button>
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #FFFFFF; -fx-background-radius: 8; -fx-cursor: hand;" text=" 💳 Lịch Sử Giao Dịch">
                    <font><Font name="Times New Roman Bold" size="15.0" /></font>
                </Button>
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #FFFFFF; -fx-background-radius: 8; -fx-cursor: hand;" text=" 💰 Nạp / Rút Tiền">
                    <font><Font name="Times New Roman Bold" size="15.0" /></font>
                </Button>
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #FFFFFF; -fx-background-radius: 8; -fx-cursor: hand;" text=" 👤 Hồ Sơ Cá Nhân">
                    <font><Font name="Times New Roman Bold" size="15.0" /></font>
                </Button>

                <VBox alignment="BOTTOM_CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Button mnemonicParsing="false" prefHeight="42.0" prefWidth="250.0" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="🔄 Chuyển sang Người bán">
                            <font><Font name="Times New Roman Bold" size="15.0" /></font>
                        </Button>
                        <Button alignment="CENTER" mnemonicParsing="false" prefHeight="42.0" prefWidth="250.0" style="-fx-background-color: #EF4444; -fx-text-fill: WHITE; -fx-background-radius: 8; -fx-cursor: hand;" text="Đăng Xuất Hệ Thống">
                            <font><Font name="Times New Roman Bold" size="15.0" /></font>
                        </Button>
                    </children>
                </VBox>
            </children>
        </VBox>

        <AnchorPane fx:id="contentArea" prefHeight="720.0" prefWidth="1000.0" HBox.hgrow="ALWAYS" />
    </children>
</HBox>