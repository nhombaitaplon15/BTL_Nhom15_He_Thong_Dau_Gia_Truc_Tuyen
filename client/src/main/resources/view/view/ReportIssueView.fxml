<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="480.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e2e8f0; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ReportIssueController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="55.0" style="-fx-background-color: #dc2626; -fx-background-radius: 12 12 0 0;">
            <children>
                <Label text="⚠ BÁO CÁO SỰ CỐ PHIÊN ĐẤU GIÁ" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets left="20.0" />
            </padding>
        </HBox>

        <VBox spacing="12.0">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Mã phiên đấu giá:" textFill="#4b5563">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtSessionId" editable="false" prefHeight="35.0" style="-fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1; -fx-border-radius: 5; -fx-text-fill: #334155;" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Loại sự cố gặp phải:" textFill="#4b5563">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cbIssueType" maxWidth="1.7976931348623157E308" prefHeight="35.0" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Mô tả chi tiết sự cố:" textFill="#4b5563">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <TextArea fx:id="txtDescription" prefHeight="120.0" promptText="Vui lòng nhập rõ tình trạng lỗi bạn gặp phải (ví dụ: bấm đặt giá nhưng hệ thống báo lỗi trừ tiền)..." style="-fx-border-color: #cbd5e1; -fx-border-radius: 5;" wrapText="true" />
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-background-color: #f8fafc; -fx-padding: 12; -fx-background-radius: 0 0 12 12;">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 5; -fx-cursor: hand;" text="Hủy bỏ" textFill="#475569" />
                <Button mnemonicParsing="false" onAction="#handleSendReport" prefHeight="35.0" style="-fx-background-color: #dc2626; -fx-background-radius: 5; -fx-cursor: hand;" text="Gửi Báo Cáo" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>