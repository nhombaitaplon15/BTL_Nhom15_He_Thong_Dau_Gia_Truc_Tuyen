<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.BiddingHistoryController">
    <style>
        .table-view {
        -fx-background-color: white;
        -fx-background-radius: 12;
        }
        /* Chỉ nhuộm xanh thanh tiêu đề (Header) */
        .table-view .column-header-background, .table-view .column-header {
        -fx-background-color: #2563EB;
        -fx-size: 45;
        }
        /* Ép toàn bộ các ô dữ liệu bên dưới bắt buộc phải có nền TRẮNG */
        .table-view .table-cell {
        -fx-background-color: white;
        -fx-border-color: #E2E8F0 transparent transparent transparent; /* Đường kẻ mờ giữa các hàng */
        -fx-padding: 12 10 12 10;
        }
        /* Hiệu ứng đổi màu nhẹ khi rê chuột vào từng hàng */
        .table-view .table-row-cell:hover .table-cell {
        -fx-background-color: #F1F5F9;
        }
        /* Xóa bỏ viền xanh mặc định khi click chọn dòng */
        .table-view .table-row-cell:filled:selected .table-cell {
        -fx-background-color: #E2E8F0;
        }
    </style>

    <children>
        <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-padding: 30 60 30 60;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefWidth="1160.0" spacing="20.0">
                    <children>
                        <Button fx:id="btnToggleMenu" mnemonicParsing="false" onAction="#onLiveMenuClick" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #2563EB; -fx-border-color: #2563EB; -fx-border-radius: 8; -fx-cursor: hand;" text="← Quay lại">
                            <font><Font name="Times New Roman Bold" size="18.0" /></font>
                            <padding><Insets left="20.0" right="20.0" /></padding>
                        </Button>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="⏱ LỊCH SỬ ĐẶT GIÁ CỦA BẠN" textFill="#2563EB">
                                    <font><Font name="Times New Roman Bold" size="28.0" /></font>
                                </Label>
                                <Label text="Danh sách chi tiết các lượt tham gia đấu giá của bạn" textFill="#64748B">
                                    <font><Font name="Times New Roman" size="16.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <children>
                                <TextField fx:id="txtSearch" prefHeight="35.0" prefWidth="220.0" promptText="Tìm kiếm tên vật phẩm..." style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #CBD5E1; -fx-font-family: 'Times New Roman'; -fx-font-size: 14px;" />
                                <Button fx:id="btnRefresh" onAction="#handleRefresh" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: #2563EB; -fx-background-radius: 6; -fx-cursor: hand;" text="🔄 Làm Mới" textFill="WHITE">
                                    <font><Font name="Times New Roman Bold" size="13.0" /></font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <Separator prefWidth="1160.0" style="-fx-opacity: 0.5;" />

                <VBox maxWidth="1160.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-padding: 1; -fx-effect: dropshadow(three-pass-box, rgba(37,99,235,0.08), 20, 0, 0, 10);" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="historyTable" prefHeight="450.0" prefWidth="1160.0" style="-fx-font-family: 'Times New Roman'; -fx-font-size: 16px;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="80.0" style="-fx-alignment: CENTER; -fx-text-fill: #1E293B;">
                                    <graphic><Label prefHeight="26.0" prefWidth="130.0" style="-fx-background-color: #2563EB; -fx-font-size: 16px;" text="STT" textFill="WHITE">
                                        <graphic>
                                            <Label />
                                        </graphic></Label></graphic>
                                </TableColumn>

                                <TableColumn fx:id="colAuctionId" prefWidth="120.0" style="-fx-alignment: CENTER; -fx-text-fill: #1E293B;">
                                    <graphic><Label prefHeight="30.0" prefWidth="127.0" style="-fx-background-color: #2563EB; -fx-font-size: 16px;" text="Mã Phiên" textFill="WHITE">
                                        <graphic>
                                            <Label />
                                        </graphic></Label></graphic>
                                </TableColumn>

                                <TableColumn fx:id="colItemName" prefWidth="350.0" style="-fx-alignment: CENTER-LEFT; -fx-text-fill: #1E293B;">
                                    <graphic><Label prefHeight="30.0" prefWidth="391.0" style="-fx-background-color: #2563EB; -fx-font-size: 16px;" text="Tên Vật Phẩm" textFill="WHITE">
                                        <graphic>
                                            <Label />
                                        </graphic></Label></graphic>
                                </TableColumn>

                                <TableColumn fx:id="colBidAmount" prefWidth="180.0" style="-fx-alignment: CENTER-RIGHT; -fx-text-fill: #2563EB; -fx-font-weight: bold;">
                                    <graphic><Label prefHeight="30.0" prefWidth="179.0" style="-fx-background-color: #2563EB; -fx-font-size: 16px;" text="Giá Đã Đặt" textFill="WHITE">
                                        <graphic>
                                            <Label prefHeight="21.0" prefWidth="0.0" />
                                        </graphic></Label></graphic>
                                </TableColumn>

                                <TableColumn fx:id="colBidTime" prefWidth="230.0" style="-fx-alignment: CENTER; -fx-text-fill: #475569;">
                                    <graphic><Label prefHeight="29.0" prefWidth="230.0" style="-fx-background-color: #2563EB; -fx-font-size: 16px;" text="Thời Gian Đặt" textFill="WHITE">
                                        <graphic>
                                            <Label />
                                        </graphic></Label></graphic>
                                </TableColumn>

                                <TableColumn fx:id="colStatus" prefWidth="180.0" style="-fx-alignment: CENTER; -fx-font-weight: bold; -fx-text-fill: #10B981;">
                                    <graphic><Label prefHeight="31.0" prefWidth="181.0" style="-fx-background-color: #2563EB; -fx-font-size: 16px;" text="Trạng Thái" textFill="WHITE">
                                        <graphic>
                                            <Label />
                                        </graphic></Label></graphic>
                                </TableColumn>
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <HBox alignment="CENTER_RIGHT" maxWidth="1160.0" spacing="15.0">
                    <children>
                        <Button onAction="#handleViewDetail" prefHeight="42.0" prefWidth="200.0" style="-fx-background-color: #1E40AF; -fx-background-radius: 6; -fx-cursor: hand;" text="Xem Chi Tiết Phiên Đấu Giá" textFill="WHITE">
                            <font><Font name="Times New Roman Bold" size="14.0" /></font>
                        </Button>
                        <Button onAction="#handleReportIssue" prefHeight="42.0" prefWidth="130.0" style="-fx-background-color: #EF4444; -fx-background-radius: 6; -fx-cursor: hand;" text="Báo Cáo Sự Cố" textFill="WHITE">
                            <font><Font name="Times New Roman Bold" size="14.0" /></font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>