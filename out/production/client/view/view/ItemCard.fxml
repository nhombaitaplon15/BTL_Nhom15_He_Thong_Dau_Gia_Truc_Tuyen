<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="310.0" prefWidth="300.0" spacing="8.0"
      style="-fx-padding: 10; -fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-background-radius: 8;"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.bidder.ItemCardController">
   <children>
      <ImageView fx:id="imgItem" fitHeight="180.0" fitWidth="280.0" pickOnBounds="true" preserveRatio="false" />
      <Label fx:id="name" prefHeight="30.0" prefWidth="280.0" text="Tên sản phẩm: " style="-fx-font-weight: bold;" />
      <Label fx:id="startPrice" prefWidth="280.0" text="Giá khởi điểm: " style="-fx-text-fill: #ff0000; -fx-font-size: 13px;" />

      <Button fx:id="btnBid" maxWidth="Infinity" prefHeight="30.0" text="Đặt Giá Ngay"
              onAction="#handleBidAction"
              style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
   </children>
</VBox>