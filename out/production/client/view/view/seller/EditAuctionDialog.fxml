<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="580" style="-fx-background-color: #F8F6F0; -fx-padding: 24; -fx-background-radius: 12;" styleClass="dialog-overlay" stylesheets="@../css/product_management.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.seller.EditAuctionController">

    <VBox spacing="4" style="-fx-padding: 0 0 16 0;">
        <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1A2B4A;" text="Sửa phiên đấu giá" />
        <Label style="-fx-font-size: 12; -fx-text-fill: #6B5E4A;" text="Chỉ có thể sửa khi phiên đang ở trạng thái Chờ duyệt" />
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #F8F6F0; -fx-border-color: #E0D5C0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;">
        <ImageView fx:id="imgItemPreview" fitHeight="48" fitWidth="48" preserveRatio="true" style="-fx-background-radius: 6;" />
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="lblItemName" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1A2B4A;" text="—" />
            <Label fx:id="lblItemMeta" style="-fx-font-size: 11; -fx-text-fill: #8B7355;" text="—" />
        </VBox>
        <VBox alignment="CENTER_RIGHT" spacing="2">
            <Label style="-fx-font-size: 10; -fx-text-fill: #A08C6E;" text="Giá khởi điểm" />
            <Label fx:id="lblStartingPrice" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #D7A859;" text="—" />
        </VBox>
    </HBox>

    <VBox spacing="16" style="-fx-background-color: white; -fx-border-color: #E0D5C0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; -fx-margin-top: 16;">

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label style="-fx-min-width: 3; -fx-pref-width: 3; -fx-min-height: 16; -fx-pref-height: 16; -fx-background-color: #D7A859; -fx-background-radius: 2;" />
            <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1A2B4A;" text="Thông tin phiên" />
        </HBox>

        <GridPane hgap="16" vgap="16">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
            </columnConstraints>

            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label style="-fx-font-size: 11; -fx-text-fill: #5A4E3A; -fx-font-weight: bold;" text="Ngày bắt đầu" />
                <DatePicker fx:id="dtpStartTime" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #D4C9B0; -fx-border-radius: 6;" />
            </VBox>
            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label style="-fx-font-size: 11; -fx-text-fill: #5A4E3A; -fx-font-weight: bold;" text="Ngày kết thúc" />
                <DatePicker fx:id="dtpEndTime" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #D4C9B0; -fx-border-radius: 6;" />
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                <Label style="-fx-font-size: 11; -fx-text-fill: #5A4E3A; -fx-font-weight: bold;" text="Giá mua ngay (tuỳ chọn)" />
                <TextField fx:id="txtBuyNowPrice" promptText="Để trống nếu không có" style="-fx-background-color: white; -fx-border-color: #D4C9B0; -fx-border-radius: 6; -fx-padding: 8;" />
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2">
                <Label style="-fx-font-size: 11; -fx-text-fill: #5A4E3A; -fx-font-weight: bold;" text="Ghi chú" />
                <TextField fx:id="txtNote" style="-fx-background-color: white; -fx-border-color: #D4C9B0; -fx-border-radius: 6; -fx-padding: 8;" />
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="3">
                <Label style="-fx-font-size: 11; -fx-text-fill: #5A4E3A; -fx-font-weight: bold;" text="Anti-snipe (giây cuối)" />
            <Button mnemonicParsing="false" prefHeight="22.0" prefWidth="197.0" text="60 giây" />
            </VBox>
            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <Label style="-fx-font-size: 11; -fx-text-fill: #5A4E3A; -fx-font-weight: bold;" text="Gia hạn thêm" />
            <Button mnemonicParsing="false" prefHeight="22.0" prefWidth="211.0" text="60 giây" />
            </VBox>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <Label style="-fx-font-size: 10.5; -fx-text-fill: #8B7355; -fx-font-style: italic;" text="* Thay đổi sẽ chờ admin duyệt lại trước khi có hiệu lực." />
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-padding: 20 0 0 0;">
        <Button onAction="#onCancel" style="-fx-background-color: transparent; -fx-text-fill: #1A2B4A; -fx-border-color: #D4C9B0; -fx-border-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" text="Huỷ thay đổi" />
        <Button fx:id="btnSave" onAction="#onSave" style="-fx-background-color: #F5F0E8; -fx-text-fill: #1A2B4A; -fx-border-color: #D4C9B0; -fx-border-radius: 6; -fx-padding: 8 16; -fx-font-weight: bold; -fx-cursor: hand;" text="💾 Lưu thay đổi" />
    </HBox>

</VBox>
