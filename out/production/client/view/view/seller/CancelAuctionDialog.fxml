<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="480" spacing="16" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 12;" stylesheets="@../css/product_management.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.seller.CancelAuctionController">

    <VBox alignment="CENTER" spacing="8">
        <Label style="-fx-font-size: 32;" text="⚠️" />
        <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1A2B4A;" text="Xác nhận huỷ phiên đấu giá" />
        <Label style="-fx-font-size: 13; -fx-text-fill: #5A4E3A;" text="Bạn sắp huỷ phiên đấu giá sau. Hành động này không thể hoàn tác." />
    </VBox>

    <VBox spacing="12" style="-fx-background-color: #F8F6F0; -fx-padding: 16; -fx-background-radius: 8; -fx-border-color: #E0D5C0; -fx-border-radius: 8;">
        <VBox spacing="2">
            <Label style="-fx-font-size: 10; -fx-text-fill: #8B7355; -fx-font-weight: bold;" text="SẢN PHẨM" />
            <Label fx:id="lblItemName" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1A2B4A;" text="—" />
        </VBox>
        <VBox spacing="2">
            <Label style="-fx-font-size: 10; -fx-text-fill: #8B7355; -fx-font-weight: bold;" text="PHIÊN" />
            <Label fx:id="lblAuctionId" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1A2B4A;" text="—" />
        </VBox>
        <VBox spacing="2">
            <Label style="-fx-font-size: 10; -fx-text-fill: #8B7355; -fx-font-weight: bold;" text="DỰ KIẾN BẮT ĐẦU" />
            <Label fx:id="lblStartTime" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1A2B4A;" text="—" />
        </VBox>
    </VBox>

    <HBox style="-fx-background-color: #FFEBEE; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #FFCDD2; -fx-border-radius: 8;">
        <Label style="-fx-text-fill: #C62828; -fx-font-size: 12;" text="⚠ Sau khi huỷ, sản phẩm sẽ chuyển về trạng thái chưa có phiên và có thể tạo phiên mới." wrapText="true" />
    </HBox>

    <HBox alignment="CENTER" spacing="12" style="-fx-padding: 10 0 0 0;">
        <Button fx:id="btnKeep" onAction="#onKeep" style="-fx-background-color: white; -fx-text-fill: #1A2B4A; -fx-border-color: #D4C9B0; -fx-border-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" text="← Giữ lại phiên" />
        <Button fx:id="btnConfirmCancel" onAction="#onConfirmCancel" style="-fx-background-color: white; -fx-text-fill: #1A2B4A; -fx-border-color: #D4C9B0; -fx-border-radius: 6; -fx-padding: 8 16; -fx-cursor: hand; -fx-font-weight: bold;" text="✕ Xác nhận huỷ" />
    </HBox>
</VBox>