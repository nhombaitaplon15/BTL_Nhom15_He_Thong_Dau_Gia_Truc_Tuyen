<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<?import javafx.scene.image.ImageView?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.controller.CreateAuctionController"
      prefWidth="560"
      stylesheets="@css/product_management.css"
      style="-fx-background-color: rgba(26,43,74,0.4); -fx-padding: 24; -fx-background-radius: 10;">

    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(26,43,74,0.2), 24, 0, 0, 6);">

        <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 16 0;">
            <Label text="Tạo phiên đấu giá mới"
                   style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1A2B4A;" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnCancel" text="✕" onAction="#onCancel"
                    style="-fx-background-color: #F5F0E8; -fx-text-fill: #6B5E4A; -fx-font-size: 13; -fx-cursor: hand; -fx-background-radius: 99; -fx-min-width: 28; -fx-pref-width: 28; -fx-min-height: 28; -fx-pref-height: 28; -fx-border-color: transparent; -fx-padding: 0;"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #F5F0E8; -fx-background-radius: 8; -fx-padding: 10 14 10 14; -fx-border-color: #E0D5C0; -fx-border-width: 0.5; -fx-border-radius: 8;">
            <ImageView fx:id="imgItemPreview"
                       fitWidth="44" fitHeight="44"
                       preserveRatio="true"
                       style="-fx-background-radius: 7;"/>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label fx:id="lblItemName" text="—"
                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1A2B4A;"/>
                <Label fx:id="lblItemMeta" text="—"
                       style="-fx-font-size: 10.5; -fx-text-fill: #8B7355;"/>
            </VBox>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label text="Giá khởi điểm"
                       style="-fx-font-size: 10; -fx-text-fill: #A08C6E;"/>
                <Label fx:id="lblStartingPrice" text="0đ"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #D7A859;"/>
            </VBox>
        </HBox>

        <VBox spacing="0" style="-fx-padding: 16 0 0 0;">

            <GridPane hgap="16" vgap="12">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                </columnConstraints>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Ngày bắt đầu"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #6B5E4A;"/>
                    <DatePicker fx:id="dtpStartTime"
                                maxWidth="Infinity"
                                style="-fx-background-color: #FDFAF4; -fx-border-color: #D4C9B0; -fx-border-width: 0.5; -fx-border-radius: 7; -fx-background-radius: 7; -fx-font-size: 12;"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Ngày kết thúc"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #6B5E4A;"/>
                    <DatePicker fx:id="dtpEndTime"
                                maxWidth="Infinity"
                                style="-fx-background-color: #FDFAF4; -fx-border-color: #D4C9B0; -fx-border-width: 0.5; -fx-border-radius: 7; -fx-background-radius: 7; -fx-font-size: 12;"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Bước giá tối thiểu (đ)"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #6B5E4A;"/>
                    <TextField fx:id="txtMinIncrement"
                               promptText="VD: 500000"
                               style="-fx-background-color: #FDFAF4; -fx-border-color: #D4C9B0; -fx-border-width: 0.5; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 7 10 7 10; -fx-font-size: 12;"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Giá mua ngay (tuỳ chọn)"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #6B5E4A;"/>
                    <TextField fx:id="txtBuyNowPrice"
                               promptText="Để trống nếu không có"
                               style="-fx-background-color: #FDFAF4; -fx-border-color: #D4C9B0; -fx-border-width: 0.5; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 7 10 7 10; -fx-font-size: 12;"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                    <Label text="Ghi chú cho phiên"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #6B5E4A;"/>
                    <TextField fx:id="txtNote"
                               promptText="VD: Xe còn đẹp, có thể xem trực tiếp..."
                               style="-fx-background-color: #FDFAF4; -fx-border-color: #D4C9B0; -fx-border-width: 0.5; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 7 10 7 10; -fx-font-size: 12;"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <Label text="Kích hoạt Anti-snipe (giây cuối)"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #6B5E4A;"/>
                    <ComboBox fx:id="cmbAntiSnipeWindow"
                              maxWidth="Infinity"
                              style="-fx-background-color: #FDFAF4; -fx-border-color: #D4C9B0; -fx-border-width: 0.5; -fx-border-radius: 7; -fx-background-radius: 7; -fx-font-size: 12;">
                        <items>
                            <FXCollections xmlns="http://javafx.com/javafx" fx:factory="observableArrayList">
                                <String fx:value="Tắt"/>
                                <String fx:value="30 giây"/>
                                <String fx:value="60 giây"/>
                                <String fx:value="120 giây"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Label text="Gia hạn thêm (giây)"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #6B5E4A;"/>
                    <ComboBox fx:id="cmbAntiSnipeExtend"
                              maxWidth="Infinity"
                              style="-fx-background-color: #FDFAF4; -fx-border-color: #D4C9B0; -fx-border-width: 0.5; -fx-border-radius: 7; -fx-background-radius: 7; -fx-font-size: 12;">
                        <items>
                            <FXCollections xmlns="http://javafx.com/javafx" fx:factory="observableArrayList">
                                <String fx:value="60 giây"/>
                                <String fx:value="120 giây"/>
                                <String fx:value="300 giây"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>
            </GridPane>

            <Label text="* Phiên sẽ chờ admin duyệt trước khi được kích hoạt."
                   style="-fx-font-size: 10.5; -fx-text-fill: #A08C6E; -fx-font-style: italic; -fx-padding: 10 0 0 0;"/>

            <HBox spacing="8" alignment="CENTER_RIGHT" style="-fx-padding: 16 0 0 0;">
                <Button text="Huỷ" onAction="#onCancel"
                        style="-fx-background-color: transparent; -fx-border-color: #D4C9B0; -fx-border-width: 0.5; -fx-border-radius: 7; -fx-background-radius: 7; -fx-text-fill: #6B5E4A; -fx-font-size: 12; -fx-padding: 7 18 7 18; -fx-cursor: hand;"/>
                <Button fx:id="btnConfirm" text="Gửi tạo phiên →" onAction="#onConfirm"
                        style="-fx-background-color: #233A66; -fx-text-fill: #FFD691; -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 7 20 7 20; -fx-background-radius: 7; -fx-cursor: hand; -fx-border-color: transparent;"/>
            </HBox>

        </VBox>
    </VBox>
</VBox>
