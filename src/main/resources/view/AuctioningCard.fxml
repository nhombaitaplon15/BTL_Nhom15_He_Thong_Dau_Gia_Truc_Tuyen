<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER_LEFT" prefHeight="90.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 3);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AuctioningCardController">
   <padding>
      <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
   </padding>
   <children>
      <AnchorPane prefHeight="60.0" prefWidth="60.0" style="-fx-background-color: #e8ecef; -fx-background-radius: 5;" />

      <VBox alignment="CENTER_LEFT" spacing="5.0">
         <HBox.margin>
            <Insets left="20.0" />
         </HBox.margin>
         <children>
            <Label fx:id="itemNameLabel" text="Tên sản phẩm" textFill="#2f3640">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <Label fx:id="categoryDateLabel" text="Danh mục · Trạng thái" textFill="#7f8fa6" />
         </children>
      </VBox>

      <Region HBox.hgrow="ALWAYS" />

      <VBox alignment="CENTER_RIGHT" spacing="2.0">
         <children>
            <Label fx:id="startPriceLabel" text="Khởi điểm: 0đ" textFill="#7f8fa6" />
            <Label fx:id="currentPriceLabel" text="0đ" textFill="#e1b12c">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Label fx:id="bidCountLabel" text="↑ 0 lượt bid" textFill="#7f8fa6" />
         </children>
         <HBox.margin>
            <Insets right="30.0" />
         </HBox.margin>
      </VBox>

      <VBox alignment="CENTER" spacing="8.0">
         <children>
            <Label style="-fx-background-color: #eafaf1; -fx-text-fill: #2ecc71; -fx-padding: 3 10 3 10; -fx-background-radius: 15;" text="Đang mở">
               <font>
                  <Font size="11.0" />
               </font>
            </Label>
            <Button fx:id="detailButton" style="-fx-background-color: transparent; -fx-border-color: #dcdde1; -fx-border-radius: 5;" text="Chi tiết" />
         </children>
      </VBox>
   </children>
</HBox>