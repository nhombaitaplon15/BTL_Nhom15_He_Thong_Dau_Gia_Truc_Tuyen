<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER_LEFT" prefHeight="90.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 3);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.PendingController">
    <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
    <children>
        <AnchorPane prefHeight="60.0" prefWidth="60.0" style="-fx-background-color: #e8ecef; -fx-background-radius: 5;" />
        <VBox alignment="CENTER_LEFT" spacing="5.0" fx:id="productListVBox">
            <HBox.margin><Insets left="20.0" /></HBox.margin>
            <children>
                <Label fx:id="itemNameLabel" text="Tên sản phẩm" textFill="#2f3640">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Label>
                <Label fx:id="timeLabel" text="Danh mục · Gửi lúc ..." textFill="#7f8fa6" />
            </children>
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <VBox alignment="CENTER_RIGHT" spacing="2.0">
            <HBox.margin><Insets right="30.0" /></HBox.margin>
            <children>
                <Label fx:id="startPriceLabel" text="Khởi điểm: 0đ" textFill="#7f8fa6" />
                <Label text="Chưa mở" textFill="#e1b12c"><font><Font name="System Bold" size="16.0" /></font></Label>
                <Label text="Chưa có bid" textFill="#7f8fa6" />
            </children>
        </VBox>
        <VBox alignment="CENTER_RIGHT" spacing="8.0">
            <HBox.margin><Insets right="20.0" /></HBox.margin>
            <children>
                <Label style="-fx-background-color: #fef9e7; -fx-text-fill: #f39c12; -fx-padding: 3 10 3 10; -fx-background-radius: 15;" text="Chờ admin duyệt"><font><Font size="11.0" /></font></Label>
            </children>
        </VBox>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="editButton" prefHeight="35.0" prefWidth="60.0" style="-fx-background-color: #192a56; -fx-text-fill: white; -fx-background-radius: 5;" text="Sửa" />
                <Button fx:id="deleteButton" prefHeight="35.0" prefWidth="60.0" style="-fx-background-color: #ffeef0; -fx-text-fill: #ff4d4d; -fx-border-color: #ffcccc; -fx-border-radius: 5;" text="Xoá" />
            </children>
        </HBox>
    </children>
</HBox>