<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="420.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 5);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.bidder.ReportIssueController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="⚠️ BÁO CÁO SỰ CỐ PHIÊN ĐẤU GIÁ" textFill="#b91c1c">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <VBox spacing="12.0">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Mã phiên liên quan: (Tự động điền)" textFill="#475569">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtSessionId" editable="false" prefHeight="35.0" style="-fx-background-radius: 6; -fx-background-color: #e2e8f0; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Phân loại sự cố:" textFill="#475569">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cbIssueType" prefHeight="35.0" prefWidth="380.0" style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-color: white;" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Mô tả chi tiết sự cố bạn gặp phải:" textFill="#475569">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <TextArea fx:id="txtDescription" prefHeight="120.0" promptText="Vui lòng ghi rõ diễn biến lỗi tại đây để Ban quản trị hỗ trợ..." style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </VBox>
        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Hủy Bỏ">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#handleSendReport" prefHeight="38.0" prefWidth="150.0" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Gửi Báo Cáo">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>